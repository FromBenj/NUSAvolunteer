<div class="d-flex flex-wrap justify-content-start">
    {% for matching in this.matchings %}
        {% set volunteer = matching.volunteer %}
        <div class="col-12 col-lg-4 d-flex justify-content-center">
            <div class="d-flex flex-column">
                <div class="card m-4 border-0" style="width: 14rem;">
                    <div class="position-relative">
                        <img id="volunteer-{{ volunteer.id }}-image" class="card-img-top" role='button' src="{{ volunteer.pictureName }}" alt="Volunteer avatar image">
                    </div>
                    <div class="card-body pb-0">
                        <h5 class="card-title text-center">{{ volunteer.FullName }}</h5>
                    </div>
                </div>
                <div class="d-flex flex-column align-items-start">
                    <div class="d-flex w-100 justify-content-center mb-4">
                        <button id="modal-button-{{ volunteer.id }}" type="button" class="btn main-button main-volunteer-button fw-bold me-4" data-bs-toggle="modal"
                                data-bs-target="#modal-{{ volunteer.id }}">
                            Profile
                        </button>
                        {% if this.needAcceptation %}
                            <a href="">
                                <button type="button" class="btn main-button main-volunteer-button fw-bold">
                                    Accept
                                </button>
                            </a>
                        {% else %}
                            <a href="">
                                <button type="button" class="btn main-button main-volunteer-button fw-bold">
                                    Chat
                                </button>
                            </a>
                        {% endif %}
                    </div>
                    {% if this.lastMessage %}
                        <div class="mb-2">Last message:</div>
                    {% endif %}
                </div>
            </div>
        </div>
