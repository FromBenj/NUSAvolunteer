{% extends 'base.html.twig' %}

{% block title %}Organisation matches{% endblock %}

{% block nav %}
    {% include 'organisation/navbar.html.twig' %}
{% endblock %}

{% block body %}
    <h1 class="my-matches-title">My matches</h1>
    {% if matches is empty %}
    <div class="d-flex flex-column justify-content-center align-items-center">
        <h2>Oups you have no match yet.</h2>
        <h5>For sure, you will find awesome volunteers here!</h5>
        <a href="{{ path("organisation_volunteers_search") }}">
            <button class="btn main-button main-volunteer-button mb-5 mt-3 fw-bold">Volunteers</button>
        </a>
    </div>
    {% else %}
        <twig:organisation-prospects :matchings="matches"  :lastMessage="true"/>
    {% endif %}
    <h2 class="my-pending-title h1 pt-5 pb-3">Pending</h2>
    {% if pending is empty %}
        <div class="d-flex flex-column justify-content-center align-items-center">
            <h2>You have no pending matches.</h2>
            <h5>For sure, you will find soon new awesome volunteers!</h5>
        </div>
    {% else %}
        <twig:organisation-prospects :matchings="pending" />
    {% endif %}
    <h2 class="my-propositions-title h1 pt-5 pb-3">Propositions</h2>
    {% if propositions is empty %}
        <div class="d-flex flex-column justify-content-center align-items-center mb-5">
            <h2>You have no match propositions.</h2>
            <h5>Just wait!</h5>
        </div>
    {% else %}
        <twig:organisation-prospects :matchings="propositions" :needAcceptation="true" />
    {% endif %}
{% endblock %}

{% block javascripts %}
    <script>
        {% for match in matches %}
            let volunteerImage = document.getElementById('volunteer-{{ match.volunteer.id }}-image');
            let modalButton = document.getElementById('modal-button-{{ match.volunteer.id }}');
            volunteerImage.addEventListener('click', () => {
                modalButton.click();
            })
        {% endfor %}
    </script>
{% endblock %}
